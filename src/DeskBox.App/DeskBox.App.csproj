<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 可执行文件名为 DeskBox.exe；根命名空间仍为 DeskBox.App -->
    <AssemblyName>DeskBox</AssemblyName>
    <RootNamespace>DeskBox.App</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\DeskBox.Infrastructure\DeskBox.Infrastructure.csproj" /></ItemGroup>
</Project>
